---
import BaseLayout from '../layouts/BaseLayout.astro';
import { books, hasPage, statusLabel } from '../content/books';

const visible = books.filter((b) => !b.hidden);
const featured = visible.find((b) => b.status === 'querying');
const nextUp = visible.filter((b) => b.status === 'revising');
const inProgress = visible.filter((b) => b.status === 'writing');

const shelves = [
  { id: 'all', label: 'All' },
  { id: 'motorsport', label: 'Motorsport' },
  { id: 'fantasy', label: 'Fantasy & Sci-Fi' },
  { id: 'historical', label: 'Historical' },
].filter((s) => s.id === 'all' || inProgress.some((b) => b.shelf === s.id));
---

<BaseLayout title="Books" description="All books by Anneliesa Liedle — motorsport romance, sci-fi, fantasy, and historical.">
  <section class="books-hero">
    <div class="container">
      <span class="books-hero__label">Library</span>
      <h1 class="animate-in">Books</h1>
      <p class="books-hero__sub animate-in animate-in--delay-1">Every world I'm building. Click in to explore.</p>
    </div>
  </section>

  {featured && (
    <section class="featured-section">
      <div class="container">
        <span class="section-kicker">Finished Manuscript</span>
        <article class="feature" style={`--accent: ${featured.accent};`}>
          <a href={`/books/${featured.slug}`} class="feature__cover" aria-label={`More about ${featured.title}`}>
            <img src={featured.image} alt={`${featured.title} cover`} />
          </a>
          <div class="feature__body">
            <div class="feature__badges">
              <span class="feature__badge feature__badge--solid">Complete</span>
              <span class="feature__badge">Currently Querying</span>
            </div>
            <span class="feature__genre">
              {featured.genre}{featured.series && <> · {featured.series}</>}
            </span>
            <h2 class="feature__title">{featured.title}</h2>
            <p class="feature__tagline">{featured.tagline}</p>
            <ul class="tag-list" aria-label="Tags">
              {featured.tags.map((tag) => <li class="tag">{tag}</li>)}
            </ul>
            <p class="feature__desc">{featured.description}</p>
            <p class="feature__characters">{featured.characters}</p>
            <div class="feature__actions">
              <a href={`/books/${featured.slug}`} class="btn btn--solid">Read more</a>
              <a href="/contact" class="btn">Agents: request pages &rarr;</a>
            </div>
          </div>
        </article>
      </div>
    </section>
  )}

  {nextUp.length > 0 && (
    <section class="next-section">
      <div class="container">
        <span class="section-kicker">Next Up</span>
        <div class="books-mosaic books-mosaic--tight">
          {nextUp.map((book) => (
            <a href={`/books/${book.slug}`} class={`tile tile--${book.theme}`} style={`--accent: ${book.accent};`}>
              <div class="tile__bg">
                <img src={book.image} alt={book.title} loading="lazy" />
                <div class="tile__overlay"></div>
                <div class="tile__glow"></div>
              </div>
              <div class="tile__content">
                <span class="tile__genre">{book.genre}{book.series && <> · {book.series}</>}</span>
                <h2 class="tile__title">{book.title}</h2>
                <p class="tile__tagline">{book.tagline}</p>
                <ul class="tag-list" aria-label="Tags">
                  {book.tags.map((tag) => <li class="tag">{tag}</li>)}
                </ul>
                <div class="tile__footer">
                  <span class="tile__status">{statusLabel[book.status]}</span>
                  <span class="tile__characters">{book.characters}</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="wip-section">
    <div class="container">
      <div class="wip-header">
        <div>
          <span class="section-kicker">Works in Progress</span>
          <p class="wip-header__sub">Drafts and worlds still under construction.</p>
        </div>
        {shelves.length > 2 && (
          <div class="chips" role="group" aria-label="Filter by genre">
            {shelves.map((s, i) => (
              <button type="button" class="chip" data-filter={s.id} aria-pressed={i === 0 ? 'true' : 'false'}>{s.label}</button>
            ))}
          </div>
        )}
      </div>

      <div class="books-mosaic">
        {inProgress.map((book, i) => {
          const Tag = hasPage(book) ? 'a' : 'div';
          return (
            <Tag
              href={hasPage(book) ? `/books/${book.slug}` : undefined}
              class={`tile tile--compact${hasPage(book) ? ' tile--link' : ''}`}
              data-shelf={book.shelf}
              style={`--accent: ${book.accent}; animation-delay: ${i * 0.08}s;`}
            >
              <span class="tile__monogram" aria-hidden="true">{book.title.replace(/^The\s+/, '').charAt(0)}</span>
              <div class="tile__content">
                <span class="tile__genre">{book.genre}{book.series && <> · {book.series}</>}</span>
                <h2 class="tile__title">
                  {book.title}
                  {book.subtitle && <span class="tile__subtitle">{book.subtitle}</span>}
                  {hasPage(book) && <span class="tile__arrow" aria-hidden="true"> &rarr;</span>}
                </h2>
                {book.tagline && <p class="tile__tagline">{book.tagline}</p>}
                <ul class="tag-list" aria-label="Tags">
                  {book.tags.map((tag) => <li class="tag">{tag}</li>)}
                </ul>
                <div class="tile__footer">
                  <span class="tile__status">{statusLabel[book.status]}</span>
                  {book.characters && <span class="tile__characters">{book.characters}</span>}
                </div>
              </div>
            </Tag>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
  const items = document.querySelectorAll<HTMLElement>('.books-mosaic [data-shelf]');
  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const filter = chip.dataset.filter;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      items.forEach((item) => {
        item.hidden = filter !== 'all' && item.dataset.shelf !== filter;
      });
    });
  });
</script>

<style>
  .books-hero {
    padding-top: calc(80px + var(--space-2xl));
    padding-bottom: var(--space-xl);
    text-align: center;
  }

  .books-hero__label,
  .section-kicker {
    display: inline-block;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: var(--color-text-dim);
    margin-bottom: var(--space-md);
  }

  .books-hero h1 {
    font-family: var(--font-display);
    font-size: 3rem;
    margin-bottom: var(--space-md);
  }

  .books-hero__sub {
    color: var(--color-text-muted);
    font-size: 1rem;
    max-width: 40ch;
    margin: 0 auto;
  }

  /* --- Tags (shared) --- */
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    margin: 0 0 0.6rem;
    padding: 0;
  }

  .tag {
    font-size: 0.58rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.9);
    border: 1px solid color-mix(in srgb, var(--accent) 70%, transparent);
    padding: 2px 9px;
    border-radius: 20px;
    white-space: nowrap;
  }

  /* --- Featured (finished) book --- */
  .featured-section {
    padding-bottom: var(--space-2xl);
  }

  .feature {
    display: grid;
    grid-template-columns: minmax(180px, 280px) 1fr;
    gap: var(--space-xl);
    align-items: center;
    padding: var(--space-xl);
    border-radius: 16px;
    background:
      radial-gradient(ellipse at 0% 0%, color-mix(in srgb, var(--accent) 18%, transparent), transparent 60%),
      var(--color-bg-card);
    border: 1px solid color-mix(in srgb, var(--accent) 40%, var(--color-border));
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.35);
    animation: tile-in 0.6s ease both;
  }

  .feature__cover {
    display: block;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5);
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .feature__cover:hover {
    transform: translateY(-4px) rotate(-0.5deg);
  }

  .feature__cover img {
    display: block;
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
  }

  .feature__badges {
    display: flex;
    gap: 0.5rem;
    margin-bottom: var(--space-md);
    flex-wrap: wrap;
  }

  .feature__badge {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 5px 14px;
    border-radius: 20px;
    border: 1px solid var(--accent);
    color: var(--accent);
  }

  .feature__badge--solid {
    background: var(--accent);
    color: #14100c;
    font-weight: 600;
  }

  .feature__genre {
    display: block;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--accent);
    margin-bottom: 0.4rem;
  }

  .feature__title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    line-height: 1.15;
    margin-bottom: 0.5rem;
  }

  .feature__tagline {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
  }

  .feature .tag-list { margin-bottom: var(--space-md); }

  .feature__desc {
    color: var(--color-text-muted);
    line-height: 1.7;
    font-size: 0.95rem;
    margin-bottom: var(--space-sm);
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .feature__characters {
    font-size: 0.8rem;
    font-style: italic;
    color: var(--color-text-dim);
    margin-bottom: var(--space-lg);
  }

  .feature__actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    padding: 10px 20px;
    border-radius: 8px;
    border: 1px solid color-mix(in srgb, var(--accent) 60%, transparent);
    color: var(--color-text);
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .btn:hover {
    background: color-mix(in srgb, var(--accent) 15%, transparent);
  }

  .btn--solid {
    background: var(--accent);
    border-color: var(--accent);
    color: #14100c;
    font-weight: 600;
  }

  .btn--solid:hover {
    background: color-mix(in srgb, var(--accent) 85%, white);
    color: #14100c;
  }

  /* --- Next up (draft complete) --- */
  .next-section {
    padding-bottom: var(--space-xl);
  }

  .books-mosaic--tight { padding-bottom: 0; }

  /* --- Works in progress --- */
  .wip-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-md);
    flex-wrap: wrap;
    margin-bottom: var(--space-lg);
  }

  .wip-header .section-kicker { margin-bottom: 0.25rem; }

  .wip-header__sub {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin: 0;
  }

  .chips {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .chip {
    font: inherit;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 6px 14px;
    border-radius: 20px;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease;
  }

  .chip:hover { border-color: var(--color-text-dim); color: var(--color-text); }

  .chip[aria-pressed='true'] {
    background: var(--color-text);
    border-color: var(--color-text);
    color: var(--color-bg);
  }

  /* --- Stacked horizontal tiles --- */
  .books-mosaic {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-bottom: var(--space-2xl);
  }

  .tile {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    color: var(--color-text);
    display: block;
    height: 200px;
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.4s ease;
    animation: tile-in 0.6s ease both;
  }

  .tile[hidden] { display: none; }

  @keyframes tile-in {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }

  a.tile:hover {
    transform: translateY(-3px);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4), inset 0 0 0 1px color-mix(in srgb, var(--accent) 35%, transparent);
  }

  /* Background image */
  .tile__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .tile__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    transition: transform 0.6s ease;
    filter: blur(4px);
  }

  a.tile:hover .tile__bg img {
    transform: scale(1.05);
  }

  /* Gradient overlay — toned per-book color wash */
  .tile__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      var(--tile-tint) 0%,
      var(--tile-tint-mid) 40%,
      var(--tile-tint-deep) 70%
    );
  }

  .tile--snowblind {
    --tile-tint: rgba(140, 180, 210, 0.18);
    --tile-tint-mid: rgba(90, 140, 180, 0.35);
    --tile-tint-deep: rgba(30, 60, 90, 0.6);
  }
  .tile--ashes-in-orbit {
    --tile-tint: rgba(130, 80, 190, 0.18);
    --tile-tint-mid: rgba(90, 50, 150, 0.35);
    --tile-tint-deep: rgba(40, 20, 80, 0.6);
  }
  .tile--slave-of-the-underworld {
    --tile-tint: rgba(196, 160, 60, 0.18);
    --tile-tint-mid: rgba(150, 110, 30, 0.35);
    --tile-tint-deep: rgba(70, 50, 15, 0.6);
  }

  /* Accent glow on hover */
  .tile__glow {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
    background: radial-gradient(ellipse at 50% 100%, color-mix(in srgb, var(--accent) 14%, transparent), transparent 70%);
  }

  a.tile:hover .tile__glow { opacity: 1; }

  /* Compact cards — early projects without a cover or blurb yet (not clickable) */
  .tile--compact {
    height: auto;
    min-height: 140px;
    background:
      linear-gradient(to right, color-mix(in srgb, var(--accent) 22%, transparent), transparent 75%),
      var(--color-bg-card);
    border: 1px solid color-mix(in srgb, var(--accent) 20%, var(--color-border));
  }

  .tile__monogram {
    position: absolute;
    left: 6%;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-display);
    font-size: 7.5rem;
    line-height: 1;
    color: color-mix(in srgb, var(--accent) 35%, transparent);
    pointer-events: none;
    user-select: none;
  }

  .tile--link:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35), inset 0 0 0 1px color-mix(in srgb, var(--accent) 40%, transparent);
  }

  .tile__arrow {
    color: var(--accent);
    font-size: 1rem;
    transition: margin-left 0.2s ease;
  }

  .tile--link:hover .tile__arrow { margin-left: 4px; }

  .tile--compact .tile__tagline {
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 0.45rem;
  }

  .tile__subtitle {
    display: block;
    font-style: italic;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.65);
    margin-top: 0.15rem;
  }

  /* Content — positioned right, vertically centered */
  .tile__content {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 1.5rem 2.5rem 1.5rem 40%;
  }

  .tile__genre {
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    margin-bottom: 0.35rem;
    color: var(--accent);
  }

  a.tile .tile__genre {
    color: color-mix(in srgb, var(--accent) 60%, white);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.6);
  }

  .tile__title {
    font-family: var(--font-display);
    font-size: 1.4rem;
    line-height: 1.2;
    margin-bottom: 0.35rem;
  }

  .tile__tagline {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 0.6rem;
    line-height: 1.4;
  }

  .tile__footer {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .tile__status {
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.9);
    background: rgba(255, 255, 255, 0.15);
    padding: 5px 14px;
    border-radius: 20px;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .tile__characters {
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.7);
    font-style: italic;
  }

  @media (max-width: 768px) {
    .feature {
      grid-template-columns: 1fr;
      padding: var(--space-lg);
    }
    .feature__cover { max-width: 200px; margin: 0 auto; }
    .tile, .tile--compact { height: auto; min-height: 150px; }
    .tile__content { padding: 1.25rem 1.5rem 1.25rem 35%; }
    .tile__title { font-size: 1.2rem; }
    .tile__tagline { font-size: 0.8rem; }
    .tile__monogram { font-size: 6rem; left: 5%; }
  }
</style>
