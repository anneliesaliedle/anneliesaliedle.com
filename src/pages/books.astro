---
import BaseLayout from '../layouts/BaseLayout.astro';
import { books, hasPage, statusLabel } from '../content/books';

const visible = books.filter((b) => !b.hidden);
const featured = visible.find((b) => b.status === 'querying');
// Draft-complete books first, then works in progress.
const inTheWorks = [
  ...visible.filter((b) => b.status === 'revising'),
  ...visible.filter((b) => b.status === 'writing'),
];

const shelves = [
  { id: 'all', label: 'All' },
  { id: 'motorsport', label: 'Motorsport' },
  { id: 'fantasy', label: 'Fantasy & Sci-Fi' },
  { id: 'historical', label: 'Historical' },
].filter((s) => s.id === 'all' || inTheWorks.some((b) => b.shelf === s.id));
---

<BaseLayout title="Books" description="All books by Anneliesa Liedle — motorsport romance, sci-fi, fantasy, and historical.">
  <section class="books-hero">
    <div class="container">
      <span class="books-hero__label">Library</span>
      <h1 class="animate-in">Books</h1>
      <p class="books-hero__sub animate-in animate-in--delay-1">Every world I'm building. Click in to explore.</p>
    </div>
  </section>

  {featured && (
    <section class="featured-section">
      <div class="container">
        <span class="section-kicker">Finished Manuscript</span>
        <article class="feature" style={`--accent: ${featured.accent};`}>
          <a href={`/books/${featured.slug}`} class="feature__cover" aria-label={`More about ${featured.title}`}>
            <img src={featured.image} alt={`${featured.title} cover`} />
          </a>
          <div class="feature__body">
            <div class="feature__badges">
              <span class="feature__badge feature__badge--solid">Complete</span>
              <span class="feature__badge">Currently Querying</span>
            </div>
            <span class="feature__genre">
              {featured.genre}{featured.series && <> · {featured.series}</>}
            </span>
            <h2 class="feature__title">{featured.title}</h2>
            <p class="feature__tagline">{featured.tagline}</p>
            <ul class="tag-list" aria-label="Tags">
              {featured.tags.map((tag) => <li class="tag">{tag}</li>)}
            </ul>
            <p class="feature__desc">{featured.description}</p>
            <p class="feature__characters">{featured.characters}</p>
            <div class="feature__actions">
              <a href={`/books/${featured.slug}`} class="btn btn--solid">Read more</a>
              <a href="/contact" class="btn">Agents: request pages &rarr;</a>
            </div>
          </div>
        </article>
      </div>
    </section>
  )}

  {inTheWorks.length > 0 && (
    <section class="works-section">
      <div class="container">
        <div class="works-header">
          <div>
            <span class="section-kicker">In the Works</span>
            <p class="works-header__sub">Drafts and worlds still under construction.</p>
          </div>
          {shelves.length > 2 && inTheWorks.length > 3 && (
            <div class="chips" role="group" aria-label="Filter by genre">
              {shelves.map((s, i) => (
                <button type="button" class="chip" data-filter={s.id} aria-pressed={i === 0 ? 'true' : 'false'}>{s.label}</button>
              ))}
            </div>
          )}
        </div>

        <div class="mini-grid">
          {inTheWorks.map((book) => {
            const linked = hasPage(book);
            const Cover = linked ? 'a' : 'div';
            return (
              <article class="mini" data-shelf={book.shelf} style={`--accent: ${book.accent};`}>
                <Cover href={linked ? `/books/${book.slug}` : undefined} class="mini__cover" aria-label={linked ? `More about ${book.title}` : undefined}>
                  {book.image ? (
                    <img src={book.image} alt={`${book.title} cover`} loading="lazy" />
                  ) : (
                    <span class="mini__monogram" aria-hidden="true">{book.title.replace(/^The\s+/, '').charAt(0)}</span>
                  )}
                </Cover>
                <div class="mini__body">
                  <span class="mini__badge">{statusLabel[book.status]}</span>
                  <span class="mini__genre">{book.genre}{book.series && <> · {book.series}</>}</span>
                  <h2 class="mini__title">
                    {linked ? <a href={`/books/${book.slug}`}>{book.title}</a> : book.title}
                  </h2>
                  {book.subtitle && <p class="mini__subtitle">{book.subtitle}</p>}
                  {book.tagline && <p class="mini__tagline">{book.tagline}</p>}
                  <ul class="tag-list" aria-label="Tags">
                    {book.tags.map((tag) => <li class="tag">{tag}</li>)}
                  </ul>
                  {book.characters && <p class="mini__characters">{book.characters}</p>}
                  {linked && <a href={`/books/${book.slug}`} class="mini__link">Read more &rarr;</a>}
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
  const items = document.querySelectorAll<HTMLElement>('.mini-grid [data-shelf]');
  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const filter = chip.dataset.filter;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      items.forEach((item) => {
        item.hidden = filter !== 'all' && item.dataset.shelf !== filter;
      });
    });
  });
</script>

<style>
  .books-hero {
    padding-top: calc(80px + var(--space-2xl));
    padding-bottom: var(--space-xl);
    text-align: center;
  }

  .books-hero__label,
  .section-kicker {
    display: inline-block;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: var(--color-text-dim);
    margin-bottom: var(--space-md);
  }

  .books-hero h1 {
    font-family: var(--font-display);
    font-size: 3rem;
    margin-bottom: var(--space-md);
  }

  .books-hero__sub {
    color: var(--color-text-muted);
    font-size: 1rem;
    max-width: 40ch;
    margin: 0 auto;
  }

  @keyframes card-in {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* --- Tags (shared) --- */
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    margin: 0 0 0.6rem;
    padding: 0;
  }

  .tag {
    font-size: 0.58rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.9);
    border: 1px solid color-mix(in srgb, var(--accent) 70%, transparent);
    padding: 2px 9px;
    border-radius: 20px;
    white-space: nowrap;
  }

  /* --- Featured (finished) book --- */
  .featured-section {
    padding-bottom: var(--space-2xl);
  }

  .feature {
    display: grid;
    grid-template-columns: minmax(180px, 280px) 1fr;
    gap: var(--space-xl);
    align-items: center;
    padding: var(--space-xl);
    border-radius: 16px;
    background:
      radial-gradient(ellipse at 0% 0%, color-mix(in srgb, var(--accent) 18%, transparent), transparent 60%),
      var(--color-bg-card);
    border: 1px solid color-mix(in srgb, var(--accent) 40%, var(--color-border));
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.35);
    animation: card-in 0.6s ease both;
  }

  .feature__cover {
    display: block;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5);
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .feature__cover:hover {
    transform: translateY(-4px) rotate(-0.5deg);
  }

  .feature__cover img {
    display: block;
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
  }

  .feature__badges {
    display: flex;
    gap: 0.5rem;
    margin-bottom: var(--space-md);
    flex-wrap: wrap;
  }

  .feature__badge {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 5px 14px;
    border-radius: 20px;
    border: 1px solid var(--accent);
    color: var(--accent);
  }

  .feature__badge--solid {
    background: var(--accent);
    color: #14100c;
    font-weight: 600;
  }

  .feature__genre {
    display: block;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--accent);
    margin-bottom: 0.4rem;
  }

  .feature__title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    line-height: 1.15;
    margin-bottom: 0.5rem;
  }

  .feature__tagline {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
  }

  .feature .tag-list { margin-bottom: var(--space-md); }

  .feature__desc {
    color: var(--color-text-muted);
    line-height: 1.7;
    font-size: 0.95rem;
    margin-bottom: var(--space-sm);
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .feature__characters {
    font-size: 0.8rem;
    font-style: italic;
    color: var(--color-text-dim);
    margin-bottom: var(--space-lg);
  }

  .feature__actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    padding: 10px 20px;
    border-radius: 8px;
    border: 1px solid color-mix(in srgb, var(--accent) 60%, transparent);
    color: var(--color-text);
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .btn:hover {
    background: color-mix(in srgb, var(--accent) 15%, transparent);
  }

  .btn--solid {
    background: var(--accent);
    border-color: var(--accent);
    color: #14100c;
    font-weight: 600;
  }

  .btn--solid:hover {
    background: color-mix(in srgb, var(--accent) 85%, white);
    color: #14100c;
  }

  /* --- In the works: smaller, quieter cards --- */
  .works-section {
    padding-bottom: var(--space-2xl);
  }

  .works-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-md);
    flex-wrap: wrap;
    margin-bottom: var(--space-lg);
  }

  .works-header .section-kicker { margin-bottom: 0.25rem; }

  .works-header__sub {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin: 0;
  }

  .chips {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .chip {
    font: inherit;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 6px 14px;
    border-radius: 20px;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease;
  }

  .chip:hover { border-color: var(--color-text-dim); color: var(--color-text); }

  .chip[aria-pressed='true'] {
    background: var(--color-text);
    border-color: var(--color-text);
    color: var(--color-bg);
  }

  .mini-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(420px, 1fr));
    gap: var(--space-lg);
  }

  .mini {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: var(--space-lg);
    align-items: start;
    padding: var(--space-lg);
    border-radius: 12px;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    transition: border-color 0.3s ease;
    animation: card-in 0.6s ease both;
  }

  .mini[hidden] { display: none; }

  .mini:hover {
    border-color: color-mix(in srgb, var(--accent) 35%, var(--color-border));
  }

  .mini__cover {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 2 / 3;
    border-radius: 6px;
    overflow: hidden;
    background: color-mix(in srgb, var(--accent) 12%, var(--color-bg-card));
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.35);
    transition: transform 0.3s ease;
  }

  a.mini__cover:hover { transform: translateY(-2px); }

  .mini__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .mini__monogram {
    font-family: var(--font-display);
    font-size: 4rem;
    color: color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .mini__badge {
    display: inline-block;
    font-size: 0.58rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    padding: 3px 10px;
    border-radius: 20px;
    margin-bottom: 0.6rem;
  }

  .mini__genre {
    display: block;
    font-size: 0.58rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: color-mix(in srgb, var(--accent) 75%, var(--color-text-muted));
    margin-bottom: 0.3rem;
  }

  .mini__title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.2;
    margin-bottom: 0.3rem;
  }

  .mini__title a {
    color: inherit;
    text-decoration: none;
  }

  .mini__title a:hover { color: var(--accent); }

  .mini__subtitle {
    font-style: italic;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 0.4rem;
  }

  .mini__tagline {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.88rem;
    color: var(--color-text-muted);
    margin-bottom: 0.6rem;
    line-height: 1.4;
  }

  .mini__characters {
    font-size: 0.72rem;
    font-style: italic;
    color: var(--color-text-dim);
    margin-bottom: 0.6rem;
  }

  .mini__link {
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .mini__link:hover { color: var(--accent); }

  @media (max-width: 768px) {
    .feature {
      grid-template-columns: 1fr;
      padding: var(--space-lg);
    }
    .feature__cover { max-width: 200px; margin: 0 auto; }
    .mini-grid { grid-template-columns: 1fr; }
    .mini { grid-template-columns: 96px 1fr; gap: var(--space-md); padding: var(--space-md); }
  }
</style>
